# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Used by src/lib/supabase.ts (browser client, anon key, public read only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── API / Serverless Functions (Vercel environment variables) ────────────────
# Used by api/cron/*.ts (server-side, service role bypasses RLS for writes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret to authenticate POST /api/cron/ingest-predictions and GET /api/cron/resolve-results
# Set to any random string (e.g. openssl rand -hex 32)
CRON_SECRET=your-random-secret
